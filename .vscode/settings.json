{
  "[c]": {
    "files.encoding": "utf8"
  },
  "[cpp]": {
    "files.encoding": "utf8"
  },
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter"
  },
  // "editor.tabSize": 2,
  "files.autoSave": "onFocusChange",
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.associations": {
    "*.inc": "c",
    ".clangd": "yaml",
    "cstring": "cpp",
    "cmath": "cpp",
    "__gx.h": "c",
    "gxenum.h": "c",
    "gxmanage.h": "c",
    "__ax.h": "c",
    "math_api.h": "c",
    "arith.h": "c",
    "card.h": "c",
    "dvd.h": "c",
    "cardpriv.h": "c",
    "__card.h": "c",
    "osexec.h": "c",
    "oscache.h": "c"
  },
  // Disable C/C++ IntelliSense, use clangd instead
  "C_Cpp.intelliSenseEngine": "default",
}
